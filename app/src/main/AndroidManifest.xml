<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KillMyApps"
        tools:targetApi="37">


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>


        <activity
            android:name=".shortcut.ShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />


        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />


        <receiver
            android:name=".widget.KillAppsWidgetProvider"
            android:exported="false"
            android:label="Kill Apps">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dedeadend.killmyapps.action.KILL_APPS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kill_apps_widget_info" />
        </receiver>


        <receiver
            android:name=".widget.KillWidget1x1Provider"
            android:exported="false"
            android:label="Kill">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dedeadend.killmyapps.action.WIDGET_ACTION" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kill_widget_1x1_info" />
        </receiver>
        <receiver
            android:name=".widget.SleepWidget1x1Provider"
            android:exported="false"
            android:label="Sleep">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dedeadend.killmyapps.action.WIDGET_ACTION" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sleep_widget_1x1_info" />
        </receiver>
        <receiver
            android:name=".widget.ComboWidget1x1Provider"
            android:exported="false"
            android:label="Kill &amp; Sleep">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dedeadend.killmyapps.action.WIDGET_ACTION" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/combo_widget_1x1_info" />
        </receiver>


        <receiver
            android:name=".widget.KillWidget1x1TransparentProvider"
            android:exported="false"
            android:label="Kill (Transparent)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dedeadend.killmyapps.action.WIDGET_ACTION" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kill_widget_1x1_transparent_info" />
        </receiver>
        <receiver
            android:name=".widget.SleepWidget1x1TransparentProvider"
            android:exported="false"
            android:label="Sleep (transparent)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dedeadend.killmyapps.action.WIDGET_ACTION" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sleep_widget_1x1_transparent_info" />
        </receiver>
        <receiver
            android:name=".widget.ComboWidget1x1TransparentProvider"
            android:exported="false"
            android:label="Kill &amp; Sleep (transparent)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dedeadend.killmyapps.action.WIDGET_ACTION" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/combo_widget_1x1_transparent_info" />
        </receiver>


        <receiver
            android:name=".widget.MultiWidget1Provider"
            android:exported="false"
            android:label="Multi Action 1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dedeadend.killmyapps.action.WIDE_WIDGET_ACTION" />
                <action android:name="dedeadend.killmyapps.action.WIDE_WIDGET_REFRESH_COUNT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_multi_1_info" />
        </receiver>
        <receiver
            android:name=".widget.MultiWidget2Provider"
            android:exported="false"
            android:label="Multi Action 2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dedeadend.killmyapps.action.WIDE_WIDGET_ACTION" />
                <action android:name="dedeadend.killmyapps.action.WIDE_WIDGET_REFRESH_COUNT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_multi_2_info" />
        </receiver>


        <service
            android:name=".service.KillTileService"
            android:exported="true"
            android:icon="@drawable/ic_snow"
            android:label="Kill Apps"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".service.SleepTileService"
            android:exported="true"
            android:icon="@drawable/ic_sleep"
            android:label="Sleep"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".service.ComboTileService"
            android:exported="true"
            android:icon="@drawable/ic_combo"
            android:label="Kill &amp; Sleep"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>


        <service
            android:name=".service.AutoKillService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitors screen state to terminate background apps upon screen off." />
        </service>
        <receiver
            android:name=".receiver.AutoKillReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="dedeadend.killmyapps.action.SCHEDULED_KILL" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>


    </application>

</manifest>